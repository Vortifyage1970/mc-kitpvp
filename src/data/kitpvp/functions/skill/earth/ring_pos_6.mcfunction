execute at @s run tp @e[tag=kitpvp.earth_ring_1] ~ ~ ~-2
execute at @s run tp @e[tag=kitpvp.earth_ring_2] ~1.4 ~ ~-1.4
execute at @s run tp @e[tag=kitpvp.earth_ring_3] ~2 ~ ~
execute at @s run tp @e[tag=kitpvp.earth_ring_4] ~1.4 ~ ~1.4
execute at @s run tp @e[tag=kitpvp.earth_ring_5] ~ ~ ~2
execute at @s run tp @e[tag=kitpvp.earth_ring_6] ~-1.4 ~ ~1.4
execute at @s run tp @e[tag=kitpvp.earth_ring_7] ~-2 ~ ~
execute at @s run tp @e[tag=kitpvp.earth_ring_8] ~-1.4 ~ ~-1.4
