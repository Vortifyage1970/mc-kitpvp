+ tellraw @s [{"text":"│ 武器攻击速度：","color":"gray"},{"text":"1.6","color":"white"}]                                        
+ tellraw @s [{"text":"│ 总护甲值：","color":"gray"},{"text":"9","color":"white"}]                                              
+ tellraw @s [{"text":"│ 总护甲韧性：","color":"gray"},{"text":"0","color":"white"}]                                            
